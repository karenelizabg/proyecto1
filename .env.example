# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MariaDB) ───────────────────────────────────
# Cadena de conexión completa usada por Drizzle/mysql2.
# Formato: mysql://usuario:password@host:puerto/nombre_db
DATABASE_URL=mysql://root:password@localhost:3306/image_repo

# Variables individuales (opcionales, útiles si prefieres no usar
# una URL única, por ejemplo en algunos entornos de despliegue).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=image_repo
